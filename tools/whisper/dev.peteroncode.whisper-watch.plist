<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.peteroncode.whisper-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/.local/share/whisper-transcribe/whisper_transcribe.py</string>
    <string>watch</string>
    <string>--root</string>
    <string>__DATA_ROOT__/refinery/whisper</string>
    <string>--out</string>
    <string>__DATA_ROOT__/refinery/sources</string>
    <string>--logs</string>
    <string>__DATA_ROOT__/refinery/logs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/whisper-watch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/whisper-watch.log</string>
</dict>
</plist>
