    "tailwindcss": "^4.3.3",
    "transcript-refinery": "workspace:*",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/markdown-it": "^14.2.0",
    "eslint": "^10.9.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
