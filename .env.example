# LiteLLM gateway — a telepítése nem ennek a projektnek a feladata,
# a projekt adottnak veszi, hogy elérhető.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=

# Az Obsidian vault abszolút útvonala. Gépenként eltér, ezért kötelezően
# környezetből jön — relatív vagy beégetett útvonal nem működhet.
VAULT_PATH=

# Felirat-források
PINCHFLAT_DOWNLOADS=
