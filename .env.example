# Másold `.env` néven a `refinery.config.yaml` mellé, és töltsd ki.
# A hiányzó fájl nem hiba. A környezetben már beállított változót a fájl nem írja felül.
# A `pnpm serve` az Infisicalból tölti a titkokat, és a `SERVE_OUT` értékét felülírja.

# A recept hívja a LiteLLM-et. A YAML nem tartalmazza.
LITELLM_API_KEY=

# A `refinery serve` ezek nélkül nem indul. A Worker a saját titkai közül a közös
# `REFINERY_SERVE_SECRET` értéket használja, a többit nem olvassa.

# Közös titok. A Worker `Authorization: Bearer` fejléccel kopogtat, a serve
# ugyanígy hív vissza a Worker `/internal/jobs/<jobId>` útvonalára.
REFINERY_SERVE_SECRET=

# A Worker nyilvános címe, útvonal nélkül. A serve hozzáteszi: `/internal/jobs/<jobId>`.
WORKER_CALLBACK_URL=

# A fetch által kiírt felirat és info.json mappája. A `pnpm serve` a
# `tmp/serve-out` mappát használja a repó gyökerében.
SERVE_OUT=

# A helyi port. Üresen `8787`. A folyamat csak a `127.0.0.1` címen hallgat.
SERVE_PORT=

# Cloudflare R2, S3 API. A bucket neve, nem a nyilvános custom domain.
# Az Access Key ID és a Secret Access Key az R2 API-tokenből jön, nem a Wrangler-tokenből.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Ezek a Cloudflare Worker titkai. A helyi `refinery serve` nem olvassa őket.
# A `wrangler secret put` viszi fel, a `pnpm serve` nem.

# A BotFather által adott token.
TELEGRAM_BOT_TOKEN=

# Vesszővel elválasztott e-mailek. Csak az ezekhez kötött Telegram-felhasználó nyit sort.
ALLOWED_EMAILS=

# A bot felhasználóneve `@` nélkül. A kötés a `t.me/<név>` címre irányít vissza.
TELEGRAM_BOT_USERNAME=

# A `setWebhook` `secret_token` mezője. 1–256 karakter: betű, szám, `_`, `-`.
# A Telegram az `X-Telegram-Bot-Api-Secret-Token` fejlécben küldi.
TELEGRAM_WEBHOOK_SECRET=

# A Tunnel nyilvános címe, útvonal nélkül. A Worker hozzáteszi: `/jobs`.
SERVE_URL=
