{
  "name": "transcript-refinery",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26.2.0"
  },
  "bin": {
    "refinery": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./classify": {
      "types": "./dist/fetch/classify.d.ts",
      "default": "./dist/fetch/classify.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsc -p tsconfig.build.json",
    "serve": "mkdir -p tmp/serve-out && infisical run --env=dev --path=/peter-mbp --projectId=1c1c1853-c58b-401f-a414-2bca9076e16f -- env SERVE_OUT=\"$PWD/tmp/serve-out\" pnpm exec tsx src/cli.ts serve",
    "worker:dev": "infisical export --env=dev --path=/peter-mbp --projectId=1c1c1853-c58b-401f-a414-2bca9076e16f --output-file=worker/.dev.vars && npx wrangler dev --config worker/wrangler.toml --port 8788 --inspector-port 9229 --test-scheduled",
    "worker:deploy": "pnpm build && npx wrangler deploy --config worker/wrangler.toml",
    "worker:migrate": "npx wrangler d1 migrations apply transcript-refinery --remote --config worker/wrangler.toml",
    "worker:migrate:local": "npx wrangler d1 migrations apply transcript-refinery --local --config worker/wrangler.toml",
    "docker:build": "docker build -t ghcr.io/pcsontos/transcript-refinery:$(node -p \"require('./package.json').version\") -t ghcr.io/pcsontos/transcript-refinery:latest .",
    "docker:push": "docker push ghcr.io/pcsontos/transcript-refinery:$(node -p \"require('./package.json').version\") && docker push ghcr.io/pcsontos/transcript-refinery:latest",
    "docker:publish": "pnpm docker:build && pnpm docker:push",
    "eval": "evalite run",
    "eval:watch": "evalite watch",
    "measure": "tsx evals/measure/run.ts",
    "calibrate": "tsx evals/measure/calibrate.ts",
    "calibrate:translate": "tsx evals/measure/calibrate-translate.ts",
    "calibrate:clean": "tsx evals/measure/calibrate-clean.ts",
    "release": "bumpp",
    "web": "pnpm build && pnpm --filter transcript-refinery-web build && pnpm --filter transcript-refinery-web start",
    "web:dev": "pnpm build && pnpm --filter transcript-refinery-web dev",
    "web:test": "pnpm build && pnpm --filter transcript-refinery-web test",
    "web:typecheck": "pnpm build && pnpm --filter transcript-refinery-web typecheck",
    "web:lint": "pnpm --filter transcript-refinery-web lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "bumpp": "^12.2.2",
    "eslint": "^10.9.1",
    "evalite": "0.19.0",
    "transcript-refinery": "workspace:*",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "ai": "^7.0.91",
    "chokidar": "5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
